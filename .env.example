DATABASE_URL="mysql://app:app@127.0.0.1:3307/book_database"
# 本番（Vercel）用に TiDB Cloud を使う場合、末尾に
# ?ssl=true&connectTimeout=10000&sslaccept=strict を付与したURLを
# Vercelのプロジェクト環境変数として設定する（.envには書かない）。
# - ssl / connectTimeout : アプリ実行時に使う mariadb ドライバー（@prisma/adapter-mariadb）向け。
#   connectTimeoutのデフォルトは1000msと短く、TLSハンドシェイクを挟むTiDB Cloudへの
#   接続では間に合わずpool timeout(45028)になりやすいため延長する。
# - sslaccept=strict : `prisma migrate deploy` などが使うPrismaのスキーマエンジン向け。
#   こちらは ssl=true を見ないため、これがないとTLSなしで接続しようとして
#   TiDB Cloudに "insecure transport" として拒否される。

# Vercel Cronからの /api/books/sync 呼び出しを保護するための共有シークレット。
# Vercel側で同名の環境変数を設定すると、Cron実行時にAuthorizationヘッダーとして自動付与される。
# ローカル開発では未設定のままでよい（未設定時は認証チェックをスキップする）。
CRON_SECRET=
